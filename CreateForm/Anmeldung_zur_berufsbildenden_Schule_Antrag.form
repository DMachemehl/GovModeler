{
  "components": [
    {
      "text": "## Anmeldung zur berufsbildenden Schule",
      "type": "text",
      "id": "Field_Titel",
      "layout": {
        "row": "Row_0"
      }
    },
    {
      "text": "Bitte fuellen Sie alle Pflichtfelder aus, um sich an der berufsbildenden Schule anzumelden. Pflichtfelder sind mit * gekennzeichnet.",
      "type": "text",
      "id": "Field_Hinweis",
      "layout": {
        "row": "Row_0"
      }
    },
    {
      "label": "Persoenliche Angaben",
      "components": [],
      "showOutline": true,
      "type": "group",
      "id": "Field_Group_Persoenlich",
      "layout": {
        "row": "Row_1"
      }
    },
    {
      "label": "Vorname",
      "type": "textfield",
      "id": "Field_Vorname",
      "key": "vorname",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 50
      },
      "layout": {
        "row": "Row_2",
        "columns": 6
      }
    },
    {
      "label": "Nachname",
      "type": "textfield",
      "id": "Field_Nachname",
      "key": "nachname",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 50
      },
      "layout": {
        "row": "Row_2",
        "columns": 6
      }
    },
    {
      "label": "Geburtsdatum",
      "type": "textfield",
      "id": "Field_Geburtsdatum",
      "key": "geburtsdatum",
      "description": "Format: TT.MM.JJJJ",
      "validate": {
        "required": true,
        "pattern": "^(0[1-9]|[12][0-9]|3[01])\\.(0[1-9]|1[012])\\.(19|20)\\d\\d$"
      },
      "layout": {
        "row": "Row_3",
        "columns": 6
      }
    },
    {
      "label": "Geschlecht",
      "values": [
        {
          "label": "Weiblich",
          "value": "w"
        },
        {
          "label": "Maennlich",
          "value": "m"
        },
        {
          "label": "Divers",
          "value": "d"
        },
        {
          "label": "Keine Angabe",
          "value": "k"
        }
      ],
      "type": "select",
      "id": "Field_Geschlecht",
      "key": "geschlecht",
      "validate": {
        "required": false
      },
      "layout": {
        "row": "Row_3",
        "columns": 6
      }
    },
    {
      "label": "Kontaktdaten",
      "components": [],
      "showOutline": true,
      "type": "group",
      "id": "Field_Group_Kontakt",
      "layout": {
        "row": "Row_4"
      }
    },
    {
      "label": "E-Mail-Adresse",
      "type": "textfield",
      "id": "Field_Email",
      "key": "email",
      "validate": {
        "required": true,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
        "maxLength": 100
      },
      "layout": {
        "row": "Row_5",
        "columns": 6
      }
    },
    {
      "label": "Telefonnummer",
      "type": "textfield",
      "id": "Field_Telefon",
      "key": "telefon",
      "validate": {
        "required": false,
        "maxLength": 30
      },
      "layout": {
        "row": "Row_5",
        "columns": 6
      }
    },
    {
      "label": "Adresse",
      "components": [],
      "showOutline": true,
      "type": "group",
      "id": "Field_Group_Adresse",
      "layout": {
        "row": "Row_6"
      }
    },
    {
      "label": "Strasse und Hausnummer",
      "type": "textfield",
      "id": "Field_Strasse",
      "key": "strasse",
      "validate": {
        "required": true,
        "minLength": 3,
        "maxLength": 100
      },
      "layout": {
        "row": "Row_7",
        "columns": 8
      }
    },
    {
      "label": "PLZ",
      "type": "textfield",
      "id": "Field_PLZ",
      "key": "plz",
      "validate": {
        "required": true,
        "pattern": "^[0-9]{5}$"
      },
      "layout": {
        "row": "Row_8",
        "columns": 4
      }
    },
    {
      "label": "Ort",
      "type": "textfield",
      "id": "Field_Ort",
      "key": "ort",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 50
      },
      "layout": {
        "row": "Row_8",
        "columns": 8
      }
    },
    {
      "label": "Schulische Angaben",
      "components": [],
      "showOutline": true,
      "type": "group",
      "id": "Field_Group_Schule",
      "layout": {
        "row": "Row_9"
      }
    },
    {
      "label": "Gewuenschte Schule",
      "type": "textfield",
      "id": "Field_GewuenschteSchule",
      "key": "gewuenschteSchule",
      "validate": {
        "required": true,
        "minLength": 3,
        "maxLength": 100
      },
      "layout": {
        "row": "Row_10",
        "columns": 8
      }
    },
    {
      "label": "Gewuenschter Bildungsgang",
      "values": [
        {
          "label": "Berufsschule (duale Ausbildung)",
          "value": "berufsschule"
        },
        {
          "label": "Berufsfachschule",
          "value": "berufsfachschule"
        },
        {
          "label": "Fachoberschule",
          "value": "fachoberschule"
        },
        {
          "label": "Berufliches Gymnasium",
          "value": "berufliches_gymnasium"
        },
        {
          "label": "Fachschule",
          "value": "fachschule"
        }
      ],
      "type": "select",
      "id": "Field_Bildungsgang",
      "key": "bildungsgang",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_11",
        "columns": 8
      }
    },
    {
      "label": "Bisheriger Schulabschluss",
      "values": [
        {
          "label": "Kein Abschluss",
          "value": "kein_abschluss"
        },
        {
          "label": "Hauptschulabschluss",
          "value": "hauptschulabschluss"
        },
        {
          "label": "Mittlerer Bildungsabschluss",
          "value": "mittlerer_bildungsabschluss"
        },
        {
          "label": "Fachhochschulreife",
          "value": "fachhochschulreife"
        },
        {
          "label": "Abitur",
          "value": "abitur"
        }
      ],
      "type": "select",
      "id": "Field_Schulabschluss",
      "key": "schulabschluss",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_12",
        "columns": 6
      }
    },
    {
      "label": "Gewuenschtes Eintrittsschuljahr",
      "type": "textfield",
      "id": "Field_Eintrittsschuljahr",
      "key": "eintrittsschuljahr",
      "description": "Format: JJJJ/JJJJ, z.B. 2026/2027",
      "validate": {
        "required": true,
        "pattern": "^(19|20)\\d\\d/(19|20)\\d\\d$"
      },
      "layout": {
        "row": "Row_12",
        "columns": 6
      }
    },
    {
      "label": "Datenschutz und Einwilligung",
      "components": [],
      "showOutline": true,
      "type": "group",
      "id": "Field_Group_Datenschutz",
      "layout": {
        "row": "Row_13"
      }
    },
    {
      "text": "Ihre personenbezogenen Daten werden ausschliesslich zur Bearbeitung Ihrer Schulanmeldung verwendet und nicht an Dritte weitergegeben.",
      "type": "text",
      "id": "Field_Datenschutzhinweis",
      "layout": {
        "row": "Row_14"
      }
    },
    {
      "label": "Ich habe die Datenschutzhinweise gelesen und stimme der Verarbeitung meiner Daten zu.",
      "type": "checkbox",
      "id": "Field_DatenschutzAkzeptiert",
      "key": "datenschutzAkzeptiert",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_15"
      }
    },
    {
      "label": "Anmeldung absenden",
      "action": "submit",
      "type": "button",
      "id": "Field_Submit",
      "layout": {
        "row": "Row_16"
      }
    }
  ],
  "type": "default",
  "id": "Anmeldung_zur_berufsbildenden_Schule_Antrag",
  "exporter": {
    "name": "GitHub-Copilot-GovModeler",
    "version": "2.0"
  },
  "executionPlatform": "Camunda Platform",
  "executionPlatformVersion": "7.20.0",
  "schemaVersion": 17
}
