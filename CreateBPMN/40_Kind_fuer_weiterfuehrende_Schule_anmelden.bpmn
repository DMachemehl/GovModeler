<?xml version="1.0" encoding="utf-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:adonis="http://www.boc-group.com"
             xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="definition__a6400000-1000-4000-8000-000000000001"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             targetNamespace="http://www.boc-group.com">
  <message id="_a6400000-1000-4000-8000-000000000002" name="Anmeldung des Kindes mit erforderlichen Angaben und Nachweisen"/>
  <message id="_a6400000-1000-4000-8000-000000000003" name="Aufnahmebestaetigung mit Informationen zum Schulbeginn"/>
  <collaboration id="Collaboration_a6400000-1000-4000-8000-000000000004" name="Kind fuer weiterfuehrende Schule anmelden" isClosed="false">
    <documentation textFormat="text/plain">Kundenbeduerfnis: Die Sorgeberechtigten benoetigen einen bestaetigten Schulplatz fuer ihr Kind an einer weiterfuehrenden Schule in Stuttgart. Kundenstart: Bedarf an weiterfuehrendem Schulplatz festgestellt. Kundenende: Aufnahmebestaetigung erhalten. Modelliert ist der regulaere erfolgreiche Eintritt in Klasse 5 einer oeffentlichen Schule mit vollstaendigen Unterlagen, erfuellten Zugangsvoraussetzungen und verfuegbarem Schulplatz. Beteiligte: Sorgeberechtigte, Schulsekretariat und Schulleitung der aufnehmenden Schule. Die Schule bearbeitet die Anmeldung und Aufnahme; das Schulverwaltungsamt ist nicht als entscheidende Stelle dargestellt. Aktuelle Anmeldevorgaben, schulartspezifische Voraussetzungen und Zustaendigkeiten sind fachlich zu bestaetigen. Grundlage: BPMN_ADONIS/BPMN_ADONIS_Template.xml, angepasst auf zwei Pools. ADONIS-Import und Zuordnung der Taskdokumentation zum UI-Feld Documentation - Element documentation sind unbestaetigt.</documentation>
    <participant id="_a6400000-1000-4000-8000-000000000005" name="Kunde" processRef="process_a6400000-1000-4000-8000-000000000010"/>
    <participant id="_a6400000-1000-4000-8000-000000000006" name="Organisation" processRef="process_a6400000-1000-4000-8000-000000000020"/>
    <messageFlow id="_a6400000-1000-4000-8000-000000000007" name="Anmeldung des Kindes mit erforderlichen Angaben und Nachweisen" sourceRef="_a6400000-1000-4000-8000-000000000015" targetRef="_a6400000-1000-4000-8000-000000000023" messageRef="_a6400000-1000-4000-8000-000000000002">
      <extensionElements>
        <adonis:connector>
          <adonis:attribute name="DISPLAY_DENOMNIATION" type="BOOL" notebook="1" sourcelang="" novalue="0"><adonis:value>true</adonis:value><adonis:metavalue/></adonis:attribute>
          <adonis:attribute name="REPRESENTATION_HAS_PROCESS" type="ENUM" notebook="1" sourcelang="" novalue="0" lang-independent="v0"><adonis:value>automatisch</adonis:value><adonis:metavalue/></adonis:attribute>
        </adonis:connector>
      </extensionElements>
    </messageFlow>
    <messageFlow id="_a6400000-1000-4000-8000-000000000008" name="Aufnahmebestaetigung mit Informationen zum Schulbeginn" sourceRef="_a6400000-1000-4000-8000-000000000028" targetRef="_a6400000-1000-4000-8000-000000000016" messageRef="_a6400000-1000-4000-8000-000000000003">
      <extensionElements>
        <adonis:connector>
          <adonis:attribute name="DISPLAY_DENOMNIATION" type="BOOL" notebook="1" sourcelang="" novalue="0"><adonis:value>true</adonis:value><adonis:metavalue/></adonis:attribute>
          <adonis:attribute name="REPRESENTATION_HAS_PROCESS" type="ENUM" notebook="1" sourcelang="" novalue="0" lang-independent="v0"><adonis:value>automatisch</adonis:value><adonis:metavalue/></adonis:attribute>
        </adonis:connector>
      </extensionElements>
    </messageFlow>
  </collaboration>
  <process id="process_a6400000-1000-4000-8000-000000000010" name="Kunde" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_a6400000-1000-4000-8000-000000000011">
      <lane id="_a6400000-1000-4000-8000-000000000011" name="Sorgeberechtigte">
        <flowNodeRef>_a6400000-1000-4000-8000-000000000012</flowNodeRef>
        <flowNodeRef>_a6400000-1000-4000-8000-000000000013</flowNodeRef>
        <flowNodeRef>_a6400000-1000-4000-8000-000000000014</flowNodeRef>
        <flowNodeRef>_a6400000-1000-4000-8000-000000000015</flowNodeRef>
        <flowNodeRef>_a6400000-1000-4000-8000-000000000016</flowNodeRef>
        <flowNodeRef>_a6400000-1000-4000-8000-000000000017</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="_a6400000-1000-4000-8000-000000000012" name="Bedarf an weiterfuehrendem Schulplatz festgestellt">
      <outgoing>_a6400000-1000-4000-8000-000000000031</outgoing>
    </startEvent>
    <task id="_a6400000-1000-4000-8000-000000000013" name="Schule auswaehlen" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sorgeberechtigten waehlen unter Beruecksichtigung des vorgesehenen Bildungswegs und der geltenden Zugangsvoraussetzungen eine weiterfuehrende Schule aus. Ergebnis ist die fuer die Anmeldung gewaehlte Schule.</documentation>
      <incoming>_a6400000-1000-4000-8000-000000000031</incoming>
      <outgoing>_a6400000-1000-4000-8000-000000000032</outgoing>
    </task>
    <task id="_a6400000-1000-4000-8000-000000000014" name="Anmeldeunterlagen zusammenstellen" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sorgeberechtigten erfassen die erforderlichen Angaben zum Kind und zu den Sorgeberechtigten. Sie stellen die nach den aktuellen Anmeldevorgaben erforderlichen Nachweise zusammen. Ergebnis sind vollstaendige Anmeldeunterlagen.</documentation>
      <incoming>_a6400000-1000-4000-8000-000000000032</incoming>
      <outgoing>_a6400000-1000-4000-8000-000000000033</outgoing>
    </task>
    <sendTask id="_a6400000-1000-4000-8000-000000000015" name="Anmeldung uebermitteln" isForCompensation="false" messageRef="_a6400000-1000-4000-8000-000000000002">
      <documentation textFormat="text/plain">Die Sorgeberechtigten reichen die Anmeldung innerhalb des vorgesehenen Anmeldezeitraums ueber den von der Schule angebotenen Zugang ein. Nachricht von den Sorgeberechtigten an das Schulsekretariat: Anmeldung des Kindes mit erforderlichen Angaben und Nachweisen.</documentation>
      <incoming>_a6400000-1000-4000-8000-000000000033</incoming>
      <outgoing>_a6400000-1000-4000-8000-000000000034</outgoing>
    </sendTask>
    <receiveTask id="_a6400000-1000-4000-8000-000000000016" name="Aufnahmebestaetigung entgegennehmen" isForCompensation="false" instantiate="false" messageRef="_a6400000-1000-4000-8000-000000000003">
      <documentation textFormat="text/plain">Die Sorgeberechtigten erhalten die Aufnahmebestaetigung der Schule mit den fuer den Schulbeginn erforderlichen Informationen. Der Schulplatz fuer das Kind ist damit bestaetigt und das Kundenbeduerfnis erfuellt.</documentation>
      <incoming>_a6400000-1000-4000-8000-000000000034</incoming>
      <outgoing>_a6400000-1000-4000-8000-000000000035</outgoing>
    </receiveTask>
    <endEvent id="_a6400000-1000-4000-8000-000000000017" name="Aufnahmebestaetigung erhalten">
      <incoming>_a6400000-1000-4000-8000-000000000035</incoming>
    </endEvent>
    <sequenceFlow id="_a6400000-1000-4000-8000-000000000031" sourceRef="_a6400000-1000-4000-8000-000000000012" targetRef="_a6400000-1000-4000-8000-000000000013"/>
    <sequenceFlow id="_a6400000-1000-4000-8000-000000000032" sourceRef="_a6400000-1000-4000-8000-000000000013" targetRef="_a6400000-1000-4000-8000-000000000014"/>
    <sequenceFlow id="_a6400000-1000-4000-8000-000000000033" sourceRef="_a6400000-1000-4000-8000-000000000014" targetRef="_a6400000-1000-4000-8000-000000000015"/>
    <sequenceFlow id="_a6400000-1000-4000-8000-000000000034" sourceRef="_a6400000-1000-4000-8000-000000000015" targetRef="_a6400000-1000-4000-8000-000000000016"/>
    <sequenceFlow id="_a6400000-1000-4000-8000-000000000035" sourceRef="_a6400000-1000-4000-8000-000000000016" targetRef="_a6400000-1000-4000-8000-000000000017"/>
  </process>
  <process id="process_a6400000-1000-4000-8000-000000000020" name="Organisation - Aufnehmende Schule" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_a6400000-1000-4000-8000-000000000021">
      <lane id="_a6400000-1000-4000-8000-000000000021" name="Schulsekretariat">
        <flowNodeRef>_a6400000-1000-4000-8000-000000000023</flowNodeRef>
        <flowNodeRef>_a6400000-1000-4000-8000-000000000024</flowNodeRef>
        <flowNodeRef>_a6400000-1000-4000-8000-000000000025</flowNodeRef>
        <flowNodeRef>_a6400000-1000-4000-8000-000000000027</flowNodeRef>
        <flowNodeRef>_a6400000-1000-4000-8000-000000000028</flowNodeRef>
        <flowNodeRef>_a6400000-1000-4000-8000-000000000029</flowNodeRef>
      </lane>
      <lane id="_a6400000-1000-4000-8000-000000000022" name="Schulleitung">
        <flowNodeRef>_a6400000-1000-4000-8000-000000000026</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="_a6400000-1000-4000-8000-000000000023" name="Anmeldung eingegangen">
      <outgoing>_a6400000-1000-4000-8000-000000000041</outgoing>
      <messageEventDefinition id="_a6400000-1000-4000-8000-000000000030" messageRef="_a6400000-1000-4000-8000-000000000002"/>
    </startEvent>
    <task id="_a6400000-1000-4000-8000-000000000024" name="Anmeldung erfassen" isForCompensation="false">
      <documentation textFormat="text/plain">Das Schulsekretariat nimmt die eingegangene Anmeldung in Bearbeitung, erfasst die Anmeldedaten und ordnet die Nachweise dem Kind zu. Ergebnis ist eine erfasste Anmeldung mit zugeordneten Unterlagen.</documentation>
      <incoming>_a6400000-1000-4000-8000-000000000041</incoming>
      <outgoing>_a6400000-1000-4000-8000-000000000042</outgoing>
    </task>
    <task id="_a6400000-1000-4000-8000-000000000025" name="Anmeldeunterlagen pruefen" isForCompensation="false">
      <documentation textFormat="text/plain">Das Schulsekretariat prueft die Vollstaendigkeit der Unterlagen sowie die fuer die Aufnahme erforderlichen Angaben und Nachweise. Im betrachteten Happy Path sind diese vollstaendig und entsprechen den geltenden Vorgaben. Ergebnis sind die fuer die Aufnahme geprueften Unterlagen.</documentation>
      <incoming>_a6400000-1000-4000-8000-000000000042</incoming>
      <outgoing>_a6400000-1000-4000-8000-000000000043</outgoing>
    </task>
    <task id="_a6400000-1000-4000-8000-000000000026" name="Aufnahme festlegen" isForCompensation="false">
      <documentation textFormat="text/plain">Die Schulleitung legt die Aufnahme im Rahmen ihrer Zustaendigkeit anhand der geprueften Unterlagen, der geltenden Aufnahmevorgaben und der verfuegbaren Kapazitaet fest. Im betrachteten Happy Path wird das Kind aufgenommen.</documentation>
      <incoming>_a6400000-1000-4000-8000-000000000043</incoming>
      <outgoing>_a6400000-1000-4000-8000-000000000044</outgoing>
    </task>
    <task id="_a6400000-1000-4000-8000-000000000027" name="Aufnahme dokumentieren" isForCompensation="false">
      <documentation textFormat="text/plain">Das Schulsekretariat dokumentiert die festgelegte Aufnahme und aktualisiert den Status der Anmeldung in der schulischen Verwaltung. Ergebnis ist eine nachvollziehbar dokumentierte Aufnahme.</documentation>
      <incoming>_a6400000-1000-4000-8000-000000000044</incoming>
      <outgoing>_a6400000-1000-4000-8000-000000000045</outgoing>
    </task>
    <sendTask id="_a6400000-1000-4000-8000-000000000028" name="Aufnahmebestaetigung uebermitteln" isForCompensation="false" messageRef="_a6400000-1000-4000-8000-000000000003">
      <documentation textFormat="text/plain">Das Schulsekretariat erstellt und versendet die Aufnahmebestaetigung mit den fuer den Schulbeginn erforderlichen Informationen. Nachricht vom Schulsekretariat an die Sorgeberechtigten: Aufnahmebestaetigung mit Informationen zum Schulbeginn.</documentation>
      <incoming>_a6400000-1000-4000-8000-000000000045</incoming>
      <outgoing>_a6400000-1000-4000-8000-000000000046</outgoing>
    </sendTask>
    <endEvent id="_a6400000-1000-4000-8000-000000000029" name="Aufnahmebestaetigung versandt">
      <incoming>_a6400000-1000-4000-8000-000000000046</incoming>
    </endEvent>
    <sequenceFlow id="_a6400000-1000-4000-8000-000000000041" sourceRef="_a6400000-1000-4000-8000-000000000023" targetRef="_a6400000-1000-4000-8000-000000000024"/>
    <sequenceFlow id="_a6400000-1000-4000-8000-000000000042" sourceRef="_a6400000-1000-4000-8000-000000000024" targetRef="_a6400000-1000-4000-8000-000000000025"/>
    <sequenceFlow id="_a6400000-1000-4000-8000-000000000043" sourceRef="_a6400000-1000-4000-8000-000000000025" targetRef="_a6400000-1000-4000-8000-000000000026"/>
    <sequenceFlow id="_a6400000-1000-4000-8000-000000000044" sourceRef="_a6400000-1000-4000-8000-000000000026" targetRef="_a6400000-1000-4000-8000-000000000027"/>
    <sequenceFlow id="_a6400000-1000-4000-8000-000000000045" sourceRef="_a6400000-1000-4000-8000-000000000027" targetRef="_a6400000-1000-4000-8000-000000000028"/>
    <sequenceFlow id="_a6400000-1000-4000-8000-000000000046" sourceRef="_a6400000-1000-4000-8000-000000000028" targetRef="_a6400000-1000-4000-8000-000000000029"/>
  </process>
