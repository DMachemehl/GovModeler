  <bpmn:process id="Process_Buerger" name="Anmeldung_zur_berufsbildenden_Schule_bearbeiten_Buerger" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Buerger" name="Anmeldebedarf festgestellt">
      <bpmn:outgoing>Flow_Buerger_Start_Ausfuellen</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Anmeldeformular_ausfuellen" name="Anmeldeformular ausfuellen">
      <bpmn:incoming>Flow_Buerger_Start_Ausfuellen</bpmn:incoming>
      <bpmn:outgoing>Flow_Buerger_Ausfuellen_Einreichen</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Anmeldung_einreichen" name="Anmeldung einreichen">
      <bpmn:incoming>Flow_Buerger_Ausfuellen_Einreichen</bpmn:incoming>
      <bpmn:outgoing>Flow_Buerger_Einreichen_Bescheid</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_Bescheid_erhalten" name="Bescheid erhalten">
      <bpmn:incoming>Flow_Buerger_Einreichen_Bescheid</bpmn:incoming>
      <bpmn:outgoing>Flow_Buerger_Bescheid_Ende</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_Bescheid" messageRef="Message_Bescheid" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_Buerger" name="Anmeldung bearbeitet">
      <bpmn:incoming>Flow_Buerger_Bescheid_Ende</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Buerger_Start_Ausfuellen" sourceRef="StartEvent_Buerger" targetRef="Task_Anmeldeformular_ausfuellen" />
