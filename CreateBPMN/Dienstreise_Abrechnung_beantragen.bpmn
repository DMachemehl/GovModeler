<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://example.com/bpmn" exporter="GitHub-Copilot-GovModeler" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_Dienstreise_Abrechnung_beantragen">
    <bpmn:participant id="Participant_Buerger" name="Buerger" processRef="Process_Buerger" />
    <bpmn:participant id="Participant_IT" name="IT" processRef="Process_IT" />
    <bpmn:participant id="Participant_Behoerde" name="Behoerde" processRef="Process_Behoerde" />
    <bpmn:messageFlow id="MsgFlow_Antrag" name="Reisekostenantrag" sourceRef="Task_Reisekostenantrag_einreichen" targetRef="StartEvent_IT_Antrag_eingegangen" />
    <bpmn:messageFlow id="MsgFlow_Antragsdaten" name="Antragsdaten" sourceRef="Task_Antragsdaten_uebermitteln" targetRef="StartEvent_Behoerde_Antragsdaten_eingegangen" />
    <bpmn:messageFlow id="MsgFlow_Freigabe" name="Freigabe" sourceRef="Task_Freigabe_erteilen" targetRef="Event_Freigabe_eingegangen" />
    <bpmn:messageFlow id="MsgFlow_Erstattungsbescheid" name="Erstattungsbescheid" sourceRef="Task_Erstattungsbescheid_bereitstellen" targetRef="Event_Erstattungsbescheid_empfangen" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Buerger" name="Dienstreise_Abrechnung_beantragen_Buerger" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Buerger" name="Dienstreise durchgefuehrt">
      <bpmn:outgoing>Flow_Start_Vorbereiten</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Reisekostenabrechnung_vorbereiten" name="Reisekostenabrechnung vorbereiten">
      <bpmn:incoming>Flow_Start_Vorbereiten</bpmn:incoming>
      <bpmn:outgoing>Flow_Vorbereiten_Einreichen</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_Erstattungsbescheid_empfangen" name="Erstattungsbescheid empfangen">
      <bpmn:incoming>Flow_Einreichen_Warten</bpmn:incoming>
      <bpmn:outgoing>Flow_Bescheid_Ende_Buerger</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_Erstattungsbescheid" messageRef="Message_Erstattungsbescheid" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_Buerger" name="Reisekostenabrechnung abgeschlossen">
      <bpmn:incoming>Flow_Bescheid_Ende_Buerger</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Vorbereiten" sourceRef="StartEvent_Buerger" targetRef="Task_Reisekostenabrechnung_vorbereiten" />
    <bpmn:sequenceFlow id="Flow_Vorbereiten_Einreichen" sourceRef="Task_Reisekostenabrechnung_vorbereiten" targetRef="Task_Reisekostenantrag_einreichen" />
    <bpmn:sequenceFlow id="Flow_Einreichen_Warten" sourceRef="Task_Reisekostenantrag_einreichen" targetRef="Event_Erstattungsbescheid_empfangen" />
    <bpmn:sequenceFlow id="Flow_Bescheid_Ende_Buerger" sourceRef="Event_Erstattungsbescheid_empfangen" targetRef="EndEvent_Buerger" />
    <bpmn:userTask id="Task_Reisekostenantrag_einreichen" name="Reisekostenantrag einreichen">
      <bpmn:incoming>Flow_Vorbereiten_Einreichen</bpmn:incoming>
      <bpmn:outgoing>Flow_Einreichen_Warten</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmn:process id="Process_IT" name="Dienstreise_Abrechnung_beantragen_IT" isExecutable="true">
    <bpmn:startEvent id="StartEvent_IT_Antrag_eingegangen" name="Antrag eingegangen">
      <bpmn:outgoing>Flow_IT_Start_Erfassen</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Antrag_erfassen" name="Antrag erfassen">
      <bpmn:incoming>Flow_IT_Start_Erfassen</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_Erfassen_Pruefen</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Vollstaendigkeit_pruefen" name="Vollstaendigkeit pruefen">
      <bpmn:incoming>Flow_IT_Erfassen_Pruefen</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_Pruefen_Uebermitteln</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Antragsdaten_uebermitteln" name="Antragsdaten uebermitteln">
      <bpmn:incoming>Flow_IT_Pruefen_Uebermitteln</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_Uebermitteln_Warten</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_Freigabe_eingegangen" name="Freigabe eingegangen">
      <bpmn:incoming>Flow_IT_Uebermitteln_Warten</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_Freigabe_Auszahlen</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_Freigabe" messageRef="Message_Freigabe" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_Erstattung_auszahlen" name="Erstattung auszahlen">
      <bpmn:incoming>Flow_IT_Freigabe_Auszahlen</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_Auszahlen_Bereitstellen</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Erstattungsbescheid_bereitstellen" name="Erstattungsbescheid bereitstellen">
      <bpmn:incoming>Flow_IT_Auszahlen_Bereitstellen</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_Bereitstellen_Ende</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_IT" name="Anfrage bearbeitet">
      <bpmn:incoming>Flow_IT_Bereitstellen_Ende</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_IT_Start_Erfassen" sourceRef="StartEvent_IT_Antrag_eingegangen" targetRef="Task_Antrag_erfassen" />
    <bpmn:sequenceFlow id="Flow_IT_Erfassen_Pruefen" sourceRef="Task_Antrag_erfassen" targetRef="Task_Vollstaendigkeit_pruefen" />
    <bpmn:sequenceFlow id="Flow_IT_Pruefen_Uebermitteln" sourceRef="Task_Vollstaendigkeit_pruefen" targetRef="Task_Antragsdaten_uebermitteln" />
    <bpmn:sequenceFlow id="Flow_IT_Uebermitteln_Warten" sourceRef="Task_Antragsdaten_uebermitteln" targetRef="Event_Freigabe_eingegangen" />
    <bpmn:sequenceFlow id="Flow_IT_Freigabe_Auszahlen" sourceRef="Event_Freigabe_eingegangen" targetRef="Task_Erstattung_auszahlen" />
    <bpmn:sequenceFlow id="Flow_IT_Auszahlen_Bereitstellen" sourceRef="Task_Erstattung_auszahlen" targetRef="Task_Erstattungsbescheid_bereitstellen" />
    <bpmn:sequenceFlow id="Flow_IT_Bereitstellen_Ende" sourceRef="Task_Erstattungsbescheid_bereitstellen" targetRef="EndEvent_IT" />
  </bpmn:process>
  <bpmn:process id="Process_Behoerde" name="Dienstreise_Abrechnung_beantragen_Behoerde" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Behoerde_Antragsdaten_eingegangen" name="Antragsdaten eingegangen">
      <bpmn:outgoing>Flow_Behoerde_Start_Zustaendigkeit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Zustaendigkeit_pruefen" name="Zustaendigkeit pruefen">
      <bpmn:incoming>Flow_Behoerde_Start_Zustaendigkeit</bpmn:incoming>
      <bpmn:outgoing>Flow_Zustaendigkeit_Richtlinien</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Reisekostenrichtlinien_anwenden" name="Reisekostenrichtlinien anwenden">
      <bpmn:incoming>Flow_Zustaendigkeit_Richtlinien</bpmn:incoming>
      <bpmn:outgoing>Flow_Richtlinien_Betrag</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Erstattungsbetrag_festlegen" name="Erstattungsbetrag festlegen">
      <bpmn:incoming>Flow_Richtlinien_Betrag</bpmn:incoming>
      <bpmn:outgoing>Flow_Betrag_Freigabe</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Freigabe_erteilen" name="Freigabe erteilen">
      <bpmn:incoming>Flow_Betrag_Freigabe</bpmn:incoming>
      <bpmn:outgoing>Flow_Freigabe_Ende</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Behoerde" name="Freigabe erteilt">
      <bpmn:incoming>Flow_Freigabe_Ende</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Behoerde_Start_Zustaendigkeit" sourceRef="StartEvent_Behoerde_Antragsdaten_eingegangen" targetRef="Task_Zustaendigkeit_pruefen" />
    <bpmn:sequenceFlow id="Flow_Zustaendigkeit_Richtlinien" sourceRef="Task_Zustaendigkeit_pruefen" targetRef="Task_Reisekostenrichtlinien_anwenden" />
    <bpmn:sequenceFlow id="Flow_Richtlinien_Betrag" sourceRef="Task_Reisekostenrichtlinien_anwenden" targetRef="Task_Erstattungsbetrag_festlegen" />
    <bpmn:sequenceFlow id="Flow_Betrag_Freigabe" sourceRef="Task_Erstattungsbetrag_festlegen" targetRef="Task_Freigabe_erteilen" />
    <bpmn:sequenceFlow id="Flow_Freigabe_Ende" sourceRef="Task_Freigabe_erteilen" targetRef="EndEvent_Behoerde" />
  </bpmn:process>
  <bpmn:message id="Message_Antrag" name="Reisekostenantrag" />
  <bpmn:message id="Message_Antragsdaten" name="Antragsdaten" />
  <bpmn:message id="Message_Freigabe" name="Freigabe" />
